#!/usr/bin/env bash
# Scans every commit that is about to leave this machine.
# stdin: "<local ref> <local sha> <remote ref> <remote sha>" per pushed ref.

dir=$(dirname "$0")
remote=$1
status=0
while read -r _ local_sha _ remote_sha; do
    case $local_sha in *[!0]*) ;; *) continue ;; esac    # branch deletion
    case $remote_sha in
        *[!0]*) "$dir/check-private" log "$remote_sha..$local_sha" || status=1 ;;
        *)      "$dir/check-private" log "$local_sha" --not --remotes="$remote" || status=1 ;;
    esac
done
exit $status
